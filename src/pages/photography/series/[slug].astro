---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PhotoGrid from '../../../components/PhotoGrid.astro';
import ProtectedPhoto from '../../../components/ProtectedPhoto.astro';
import { withBase } from '../../../consts';

export async function getStaticPaths() {
	const seriesList = await getCollection('series');
	return seriesList.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const photos = (await getCollection('photos'))
	.filter((p) => p.data.series === entry.id)
	.sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
	<section class="section">
		<div class="wrap">
			<p class="eyebrow">
				<a href={withBase('/photography')}>Photography</a> / Series
			</p>
			<h1 class="rise">{entry.data.title}</h1>
			<p class="meta rise rise-delay-1">
				{entry.data.year}
				{
					entry.data.genres.length > 0 && (
						<>
							{' · '}
							{entry.data.genres.map((g, i) => (
								<>
									{i > 0 && ', '}
									<a href={withBase(`/photography/${g}`)}>{g}</a>
								</>
							))}
						</>
					)
				}
			</p>
			<p class="lead rise rise-delay-1">{entry.data.summary}</p>
			<div class="cover rise rise-delay-2">
				<ProtectedPhoto src={withBase(entry.data.cover)} alt="" class="cover-frame" loading="eager" />
			</div>
			<div class="prose rise rise-delay-2">
				<Content />
			</div>
			<div class="rise rise-delay-3" style="margin-top: 2.5rem">
				<h2>Frames</h2>
				<PhotoGrid photos={photos} />
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.meta {
		font-family: var(--font-display);
		font-weight: 600;
		color: var(--ink-muted);
		text-transform: capitalize;
	}

	.lead {
		font-size: 1.15rem;
		max-width: 38rem;
		color: var(--ink-muted);
	}

	.cover {
		margin: 1.75rem 0 2rem;
	}

	.cover :global(.cover-frame) {
		width: 100%;
		max-height: 70vh;
		aspect-ratio: 16 / 9;
		animation: fade 900ms var(--ease) both;
	}
</style>
