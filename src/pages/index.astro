---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ExperienceList from '../components/ExperienceList.astro';
import ProjectCard from '../components/ProjectCard.astro';
import {
	PROFILE,
	SITE_DESCRIPTION,
	SITE_LOCATION,
	SITE_TAGLINE,
	SITE_TITLE,
	SOCIAL,
	withBase,
} from '../consts';

const experience = (await getCollection('experience'))
	.sort((a, b) => a.data.order - b.data.order)
	.slice(0, 4);

const featuredProjects = (await getCollection('projects'))
	.filter((p) => p.data.featured)
	.sort((a, b) => a.data.order - b.data.order)
	.slice(0, 3);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="hero section">
		<div class="wrap hero-grid">
			<div class="hero-copy">
				<p class="eyebrow rise">Pune · Backend · Data · AI-augmented delivery</p>
				<h1 class="brand-mark rise rise-delay-1">{SITE_TITLE}</h1>
				<p class="role rise rise-delay-1">{SITE_TAGLINE}</p>
				<p class="tagline rise rise-delay-2">
					Nine years shipping backend and large-scale data systems across fintech, pricing
					platforms, and scientific instrument control — now pairing that depth with MCP,
					Agent Skills, and AI-assisted TDD so delivery stays fast without losing quality.
				</p>
				<p class="intro rise rise-delay-2">
					Shubham is a quick learner who believes in solving problems with simplicity. He
					is an empathetic team player and likes being the go-to person for people on the
					team. He values a comfortable team atmosphere most of all, and puts real effort
					into planning activities that build and sustain that comfort. He is
					feedback-focused and believes in mutual growth through constant feedback. He
					loves mentoring folks and sharing what he has learned in every way he can.
				</p>
				<div class="btn-row rise rise-delay-3">
					<a class="btn btn-primary" href={withBase('/work')}>Experience &amp; work</a>
					<a class="btn btn-ghost" href={SOCIAL.cvRequest}>Request CV</a>
					<a class="btn btn-ghost" href={withBase('/blog')}>Blog</a>
				</div>
			</div>
			<aside class="hero-aside rise rise-delay-2" aria-label="Profile and focus areas">
				<img
					class="hero-portrait"
					src={withBase(PROFILE.src)}
					srcset={`${withBase(PROFILE.src)} 701w`}
					sizes="(max-width: 900px) 90vw, 280px"
					alt={PROFILE.alt}
					width="701"
					height="1024"
					loading="eager"
					decoding="async"
				/>
				<p class="aside-label">Focus</p>
				<ul>
					<li>AI-augmented engineering (Claude, Cursor, MCP)</li>
					<li>Scala · Kotlin · Node.js · Apache Spark · Akka · Go</li>
					<li>Event-driven systems · Kafka · SQS/SNS</li>
					<li>AWS data pipelines · Databricks · observability</li>
					<li>Agile · Microservices · RESTful APIs · Extreme Programming</li>
				</ul>
				<p class="aside-meta muted">{SITE_LOCATION}</p>
			</aside>
		</div>
	</section>

	<section class="section band">
		<div class="wrap">
			<div class="section-intro rise">
				<p class="eyebrow">Career</p>
				<h2>Experience overview</h2>
				<p>
					From Thoughtworks STEP through fintech payment platforms — condensed roles below.
					Full detail on the work page.
				</p>
			</div>
			<div class="rise rise-delay-1">
				<ExperienceList items={experience} compact />
			</div>
			<p class="rise rise-delay-2">
				<a class="text-link" href={withBase('/work')}>Full experience &amp; selected projects →</a>
			</p>
		</div>
	</section>

	<section class="section">
		<div class="wrap">
			<div class="section-intro rise">
				<p class="eyebrow">Selected work</p>
				<h2>What I’ve shipped</h2>
				<p>Highlights from recent and career-defining delivery.</p>
			</div>
			<div class="rise rise-delay-1">
				{featuredProjects.map((project) => <ProjectCard project={project} />)}
			</div>
		</div>
	</section>

	<section class="section band-soft">
		<div class="wrap photo-cta">
			<div>
				<p class="eyebrow">Also</p>
				<h2>Photography</h2>
				<p class="muted">
					A parallel practice — street, landscape, and series work when I’m not in the
					codebase. More frames on Instagram:{' '}
					<a href={SOCIAL.instagramMemories} rel="noopener noreferrer" target="_blank">
						@memories_in_jpg
					</a>
					{' '}and{' '}
					<a href={SOCIAL.instagramClicks} rel="noopener noreferrer" target="_blank">
						@clicks.by.shubham
					</a>.
				</p>
			</div>
			<a class="btn btn-ghost" href={withBase('/photography')}>View portfolio</a>
		</div>
	</section>
</BaseLayout>

<style>
	.hero {
		padding-top: clamp(2rem, 5vw, 3.5rem);
	}

	.hero-grid {
		display: grid;
		gap: 2.5rem;
		align-items: start;
	}

	@media (min-width: 900px) {
		.hero-grid {
			grid-template-columns: minmax(0, 1.4fr) minmax(16rem, 0.85fr);
			gap: 3rem;
		}
	}

	.brand-mark {
		font-size: clamp(2.6rem, 7vw, 4.4rem);
		margin-bottom: 0.35rem;
		color: var(--ink);
	}

	.role {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1.15rem;
		color: var(--accent);
		margin: 0 0 1rem;
	}

	.tagline {
		margin: 0;
		font-size: 1.12rem;
		line-height: 1.55;
		color: var(--ink-muted);
		max-width: 38rem;
	}

	.intro {
		margin: 1.15rem 0 0;
		font-size: 1.05rem;
		line-height: 1.6;
		color: var(--ink);
		max-width: 40rem;
	}

	.hero-copy,
	.hero-aside,
	.band,
	.section {
		color: var(--ink);
	}

	.hero-aside li {
		color: var(--ink);
	}

	.hero-aside {
		padding: 1.15rem 1.2rem 1.35rem;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background:
			linear-gradient(160deg, color-mix(in srgb, var(--accent-soft) 55%, transparent), transparent 70%),
			var(--bg-elevated);
	}

	.hero-portrait {
		width: 100%;
		max-width: 280px;
		height: auto;
		aspect-ratio: auto;
		object-fit: contain;
		object-position: center top;
		border-radius: var(--radius);
		margin-bottom: 1.1rem;
		background: var(--photo-frame-bg);
	}

	.aside-label {
		font-family: var(--font-display);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		margin: 0 0 0.85rem;
		color: var(--accent);
	}

	.hero-aside ul {
		margin: 0;
		padding-left: 1.1rem;
		display: grid;
		gap: 0.55rem;
		font-size: 0.98rem;
	}

	.aside-meta {
		margin: 1.1rem 0 0;
		font-size: 0.9rem;
	}

	.band {
		background: color-mix(in srgb, var(--bg-elevated) 80%, var(--accent-soft));
		border-block: 1px solid var(--line);
	}

	.band-soft {
		border-top: 1px solid var(--line);
	}

	.text-link {
		font-family: var(--font-display);
		font-weight: 600;
		text-decoration: none;
	}

	.text-link:hover {
		text-decoration: underline;
	}

	.photo-cta {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1.25rem;
	}

	.photo-cta h2 {
		margin-bottom: 0.4rem;
	}

	.photo-cta p {
		margin-bottom: 0;
		max-width: 32rem;
	}
</style>
